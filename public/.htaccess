Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Keep the PHP map proxy reachable on Apache shared hosting.
  RewriteRule ^map-proxy\.php$ - [L]

  # Serve existing static files and directories normally.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback for direct page loads.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|png|jpg|jpeg|gif|webp|svg|wasm|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "^(index\.html|map-proxy\.php)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
